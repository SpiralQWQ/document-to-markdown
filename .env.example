# document-to-markdown 环境配置模板
# 复制为 .env 并填写本机路径后使用；或直接用环境变量/命令行设置。
# 所有脚本通过 paths.py 读取这些变量（未设置时用默认值）。

# === 路径配置 ===
# 数据根目录（你的文档所在），默认 = 仓库上一级目录
DTM_ROOT=

# MinerU 虚拟环境路径（必须指向实际安装位置）
# 例: DTM_MINERU_ENV=E:\path\to\mineru-env_Env
DTM_MINERU_ENV=

# GLM 桥接代理目录（可选，hybrid 模式用）
DTM_BRIDGE_DIR=

# Pandoc 可执行文件路径（可选，T5 导出用；默认用 PATH 上的 pandoc）
DTM_PANDOC=

# Pix2Text 虚拟环境路径（可选，公式复核用；未设置则跳过）
DTM_PIX2TEXT_ENV=

# text-cleaning-engine 仓库路径（可选，联动清洗用）
DTM_CLEANER_PATH=

# === API 密钥（不要提交到 git）===
# MinerU 云端 API Token（mineru_day.py 云端模式用）
MINERU_API_TOKEN=

# GLM API Key（hybrid 模式用）
GLM_API_KEY=
